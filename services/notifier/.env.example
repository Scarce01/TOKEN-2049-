DEPLOY_NAME=base-sepolia
# team channel (any HTTPS endpoint that accepts a JSON POST); optional
NOTIFY_WEBHOOK_URL=
# per-user channels: notifier_svc can read only quorum_index.notify_channels; optional
DATABASE_URL=postgres://notifier_svc:CHANGE_ME@HOST:5432/postgres
# optional: RPC_URL, NOTIFY_FROM_BLOCK (default: latest at start), NOTIFY_INTERVAL_MS (default 10000)
