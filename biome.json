{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!contracts/lib",
      "!contracts/out",
      "!contracts/cache",
      "!**/generated",
      "!**/.ponder",
      "!**/dist",
      "!**/.cre_build_tmp.js",
      "!reports",
      "!deployments",
      "!**/binary.wasm",
      "!analysis/trace_bybit/results",
      "!apps/observatory",
      "!archive",
      "!media"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
